{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mylaws.bd/schemas/draft_prepare_request.schema.json",
  "title": "DraftPrepareRequest",
  "type": "object",
  "required": ["type", "facts"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["gd", "dife", "dncrp"]
    },
    "facts": {
      "type": "object",
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fieldId", "value"],
            "properties": {
              "fieldId": { "type": "string" },
              "value": { "type": "string" },
              "status": { "type": "string" },
              "provenance": { "type": "string" }
            }
          }
        }
      }
    },
    "id": { "type": "string" }
  },
  "additionalProperties": true
}
